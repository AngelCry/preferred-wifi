<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Предпочитаемые Wi-Fi сети" android:textSize="20sp" android:textStyle="bold" android:paddingBottom="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отметьте сети, которые Android должен предпочитать. Приложение обнаруживает их при системном сканировании без постоянного опроса." android:textSize="14sp" android:paddingBottom="12dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRefresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Обновить" android:layout_marginEnd="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnApply" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Применить" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnMonitor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Включить фоновое наблюдение" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Без Shizuku приложение пока только обнаруживает предпочитаемые сети и передаёт предпочтения Android. Принудительное переключение будет отдельным режимом." android:textSize="12sp" android:paddingTop="8dp" />
</LinearLayout>